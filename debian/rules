#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:

override_dh_auto_install:
	mkdir -p debian/losk/usr/lib/losk
	cp -r packaging/. debian/losk/
	install -m 644 src/*.py debian/losk/usr/lib/losk/
	chmod 755 debian/losk/usr/bin/losk
	mkdir -p debian/losk/usr/share/icons/hicolor/512x512/apps
	set -e; \
	for f in assets/icons/*.png; do \
	  if [ -f "$$f" ]; then \
	    install -m 644 "$$f" debian/losk/usr/share/icons/hicolor/512x512/apps/losk.png; \
	    break; \
	  fi; \
	done
